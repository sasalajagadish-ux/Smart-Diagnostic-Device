# Git ignore file for SDD Smart Diagnostic Device project

# ─── PlatformIO ──────────────────────────────────────────────────────────────
firmware/.pio/
firmware/.vscode/

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.env
venv/
dist/
build/

# ─── Node / npm (if web tooling added) ───────────────────────────────────────
node_modules/
npm-debug.log*

# ─── OS files ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor ──────────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp

# ─── Secrets ─────────────────────────────────────────────────────────────────
*.env
secrets.h
credentials.h

# ─── Large binary files (use Git LFS or store externally) ────────────────────
*.mp4
*.avi

# ─── Build artifacts ─────────────────────────────────────────────────────────
*.o
*.obj
*.elf
*.hex
